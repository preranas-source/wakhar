# MariaDB/MySQL Database URL
DATABASE_URL=mysql+pymysql://username:password@localhost/database_name

# Redis Cache URL
REDIS_URL=redis://localhost:6379/0

# Agri Fleet Integration
AGRI_FLEET_URL=http://agrifleet.local:8000
AGRI_FLEET_API_KEY=your_api_key_here
AGRI_FLEET_API_SECRET=your_api_secret_here
AGRI_FLEET_WEBHOOK_SECRET=your_webhook_secret_here

# JWT secret key
SECRET_KEY=your-secret-key-here-for-development

# Environment
ENVIRONMENT=development
